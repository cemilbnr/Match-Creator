# --- Node / Vite ---
web-app/node_modules/
web-app/dist/
web-app/.vite/
web-app/*.local

# --- Tauri / Rust ---
web-app/src-tauri/target/
web-app/src-tauri/gen/schemas/
web-app/src-tauri/Cargo.lock

# --- Python / Blender addon ---
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# --- Claude / planning artefacts live outside the repo ---
.claude/

# --- Build outputs / release packages ---
releases/
*.msi
*.msi.sig
*.nsis.sig
*.exe
*.zip
!docs/**/*.zip

# --- Tauri signing keys (NEVER commit) ---
*.key
**/match-creator.key
**/match-creator
!**/match-creator.pub

# --- Local env overrides ---
.env
.env.local
.env.*.local

# --- Dev sandbox copies (canonical frontend lives at web-app/) ---
Match_Creator_Frontend/

# --- Asset source folders (canonical asset lives at match_creator_addon/assets/) ---
blender_default_asset/

# --- Internal-only docs (local reference, never publish) ---
# These markdown files live in docs/ but are private design notes,
# release recipes with secrets, or design references the maintainer
# wants on disk but not on GitHub. See docs/SECURITY.md for the full
# table + rationale. Add new private docs here AND in SECURITY.md in
# the same change.
docs/PRIORITIES.md
docs/RELEASING.md
docs/BLENDER_BOARD_CONTROLLER_SPEC.md
docs/SECURITY.md
docs/style-reference.png
